# Copy to .env.local and fill in. Every variable below is read somewhere in the
# app; a missing one surfaces at runtime, not at build time, so `npm run build`
# will pass with an empty file and the app will still fail in the browser.

# --- Supabase -----------------------------------------------------------------
# Project settings -> Data API. The anon key is safe to expose to the browser
# (both are NEXT_PUBLIC_); row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- App ----------------------------------------------------------------------
# Absolute origin, no trailing slash. Used to build Stripe OAuth redirect URLs,
# so it must match the callback registered in your Stripe app exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe -------------------------------------------------------------------
# Secret used to encrypt connected accounts' Stripe keys before they are stored.
# Generate one with:  openssl rand -base64 32
# Changing this makes every previously stored key undecryptable.
STRIPE_KEY_ENCRYPTION_SECRET=generate_with_openssl_rand_base64_32

# --- LLM provider: NVIDIA NIM (OpenAI-compatible API) -------------------------
# Powers /api/ai/recommend. Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
